        visible = "[Not(GetVariableSystem.Exists('sakuya_b9_disable_border'))]"
        size = { 1200 720 }
        parentanchor = center
        alwaystransparent = yes
        icon = {
            size = { 1200 720 }
            alwaystransparent = yes
            spriteType = Corneredtiled
            spriteborder = { 600 400 }
            spriteborder_bottom = 0
            texture_density = 2
            texture = "gfx/interface/main_hud/ui_paus_frame.dds"
