window = {
    name = "sakuya_main_window"
    parentanchor = center
    position = { 0 0 }
    size = { 1200 720 }
    layer = windows_layer
    allow_outside = yes
    movable = yes
    alwaystransparent = no
    using = Window_Background
    using = Window_Decoration
    visible = "[And(Or(GetVariableSystem.Exists('sakuya_main_visible'), GetVariableSystem.Exists('sakuya_main_force_show')), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid)]"
    state = {
        name = _show
        using = Animation_FadeIn_Quick
    }
    state = {
        name = _hide
        using = Animation_FadeOut_Quick
    } 
    widget = { #基板 不可更改
        size = { 1200 720 }
        parentanchor = center
        icon = {
            color = { 1 1 1 0.7 }
            texture = "gfx/interface/sakuya/main/bk.png"
            parentanchor = center
            alwaystransparent = yes
            size = { 99% 99% }
        }
    }
    widget = {
        visible = "[Not(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(GetVariableSystem.Exists('sakuya_b9_wallpaper_2'), GetVariableSystem.Exists('sakuya_b9_wallpaper_3')), GetVariableSystem.Exists('sakuya_b9_wallpaper_4')), GetVariableSystem.Exists('sakuya_b9_wallpaper_5')), GetVariableSystem.Exists('sakuya_b9_wallpaper_6')), GetVariableSystem.Exists('sakuya_b9_wallpaper_7')), GetVariableSystem.Exists('sakuya_b9_wallpaper_8')), GetVariableSystem.Exists('sakuya_b9_wallpaper_9')), GetVariableSystem.Exists('sakuya_b9_wallpaper_10')), GetVariableSystem.Exists('sakuya_b9_wallpaper_11')), GetVariableSystem.Exists('sakuya_b9_wallpaper_12')), GetVariableSystem.Exists('sakuya_b9_wallpaper_13')), GetVariableSystem.Exists('sakuya_b9_wallpaper_14')))]"
