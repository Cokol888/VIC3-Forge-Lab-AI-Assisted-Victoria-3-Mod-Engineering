window = {
    name = "sakuya_tag_index_alpha_window"
    parentanchor = center
    size = { 1280 720 }
    layer = windows_layer
    filter_mouse = all
    allow_outside = yes
    movable = yes
    visible = "[GetVariableSystem.HasValue('sakuya_list_window', 'alt_idx')]"
    onmousehierarchyenter = "[SetCanOpenRightClickContextMenu( '(bool)no' )]"
    onmousehierarchyleave = "[SetCanOpenRightClickContextMenu( '(bool)yes' )]"
    using = Window_Background
    using = Window_Decoration
    state = { name = _show using = Animation_FadeIn_Quick on_start = "[GetVariableSystem.Clear('sakuya_list_index_mode')]" on_start = "[GetVariableSystem.Clear('sakuya_list_index_letter')]" on_start = "[GetVariableSystem.Clear('sakuya_list_geo_filter')]" on_start = "[GetVariableSystem.Clear('sakuya_list_geo_filter_active')]" on_start = "[GetVariableSystem.Clear('sakuya_list_letter_filter_active')]" on_start = "[GetVariableSystem.Clear('sakuya_list_show_existing_tags')]" }
    state = { name = _hide using = Animation_FadeOut_Quick }
    widget = {
        size = { 1280 720 }
        parentanchor = center
        icon = {
            texture = "gfx/interface/sakuya/main/bk.png"
            parentanchor = center
            alwaystransparent = yes
            size = { 100% 100% }
        }
    }
    button = {
        icon = {
        texture = "gfx/interface/sakuya/main/cross.png"
            parentanchor = center
            alwaystransparent = yes
        }
        tooltip = "SKY_1.1_CLOSE"
        parentanchor = top|right
        position = { 0 0 }
        size = { 45 46 }
        onclick = "[GetVariableSystem.Clear('sakuya_list_window')]"
        onclick = "[GetVariableSystem.Set('sakuya_main_visible', 'yes')]"
        onclick = "[GetVariableSystem.Clear('sakuya_list_geo_filter_active')]"
        onclick = "[GetVariableSystem.Clear('sakuya_list_letter_filter_active')]"
        onclick = "[GetVariableSystem.Clear('sakuya_list_geo_filter')]"
        onclick = "[GetVariableSystem.Clear('sakuya_list_index_letter')]"
        onclick = "[GetVariableSystem.Clear('sakuya_list_show_existing_tags')]"
        shortcut = "close_window"
    }
    textbox = { position = { 0 26 } size = { 1280 40 } text = "SKY_LIST_TAG_INDEX_TITLE" fontsize = 30 align = center|nobaseline }
    widget = {
        position = { 34 78 }
        size = { 870 610 }
        background = { using = dark_area }
