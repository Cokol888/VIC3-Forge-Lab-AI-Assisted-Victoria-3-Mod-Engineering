                        text_single = { visible = "[Not(GetScriptedGui('sakuya_list_tag_available_alt_idx_ZUL').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 282 22 } text = "SKY_LIST_TAG_TT_EXISTS" font = "OpenSans" fontsize = 13 align = left|nobaseline }
                    }
                }
                widget = {
                    visible = "[GetVariableSystem.HasValue('sakuya_list_confirmed_tag', 'ZWY')]"
                    size = { 282 170 }
                    vbox = {
                        spacing = 6
                        hbox = {
                            spacing = 10
                            widget = { size = { 84 34 } background = { using = dark_area } text_single = { parentanchor = center raw_text = "#v ZWY#!" font = "OpenSans" fontsize = 16 align = center|nobaseline } }
                            text_single = { size = { 186 34 } text = "SKY_LIST_TAG_NAME_ZWY" font = "OpenSans" fontsize = 18 fontsize_min = 11 align = left|nobaseline elide = right }
                        }
                        hbox = { spacing = 6 text_single = { size = { 78 22 } text = "SKY_LIST_FIELD_RELEASABLE" font = "OpenSans" fontsize = 14 align = left|nobaseline } text_single = { size = { 60 22 } text = "SKY_LIST_META_NO" font = "OpenSans" fontsize = 14 align = left|nobaseline } }
                        hbox = { spacing = 6 text_single = { size = { 78 22 } text = "SKY_LIST_FIELD_FORMABLE" font = "OpenSans" fontsize = 14 align = left|nobaseline } text_single = { size = { 60 22 } text = "SKY_LIST_META_NO" font = "OpenSans" fontsize = 14 align = left|nobaseline } }
