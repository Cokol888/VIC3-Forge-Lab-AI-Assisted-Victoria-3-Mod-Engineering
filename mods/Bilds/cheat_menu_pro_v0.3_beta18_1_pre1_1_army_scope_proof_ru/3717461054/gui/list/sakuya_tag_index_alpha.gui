                        text_single = { visible = "[Not(GetScriptedGui('sakuya_list_tag_available_alt_idx_ZWY').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 282 22 } text = "SKY_LIST_TAG_TT_EXISTS" font = "OpenSans" fontsize = 13 align = left|nobaseline }
                    }
                }
            }
            button = {
                name = "sakuya_list_clear_confirmed"
                position = { 10 252 }
                size = { 282 36 }
                onclick = "[GetVariableSystem.Clear('sakuya_list_confirmed_tag')]"
                onclick = "[GetScriptedGui('sakuya_list_tag_clear_selected').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                background = { using = dark_area }
                icon = { visible = "[GetVariableSystem.Exists('sakuya_list_confirmed_tag')]" size = { 100% 100% } texture = "gfx/interface/backgrounds/big_header_pattern.dds" spriteType = Corneredtiled texture_density = 2 color = { 0.58 0.18 0.25 0.85 } }
                textbox = { parentanchor = center size = { 100% 100% } text = "SKY_LIST_CLEAR_CONFIRMED" font = "OpenSans" fontsize = 16 align = center|nobaseline }
