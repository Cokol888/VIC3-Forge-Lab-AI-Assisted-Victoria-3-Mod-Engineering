# 以咲夜之名 献予诸位 - Victoria 3 Edition
window = {
    name = "sakuya_main_window"
    parentanchor = center
    position = { 0 0 }
    size = { 1200 720 }
    layer = windows_layer
    allow_outside = yes
    movable = yes   
    alwaystransparent = no
    using = Window_Background
    using = Window_Decoration
    visible = "[And(Or(GetVariableSystem.Exists('sakuya_main_visible'), GetScriptedGui('sakuya_main_force_show_check').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid)]"
    state = { name = _show using = Animation_FadeIn_Quick }
    state = { name = _hide using = Animation_FadeOut_Quick }

    # 关闭按钮
    close_button = {
        parentanchor = top|right
        position = { -8 8 }
        size = { 40 40 }
        onclick = "[GetVariableSystem.Clear('sakuya_main_visible')]"
        onclick = "[GetScriptedGui('sakuya_main_force_show_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        shortcut = "close_window"
    }

    # 窗口标题
    textbox = {
        position = { 40 15 }
        size = { 400 40 }
        text = "SKY_WINDOW_TITLE"
        fontsize = 22
        align = left|nobaseline
    }

    # 欢迎文字
    textbox = {
        position = { 100 70 }
        size = { 1000 60 }
        fontsize = 42
        text = "SKY_DEFAULT_TITLE"
    }

    # ============================================================
    # 默认大图 - 无按钮点击时显示
    # ============================================================
    widget = {
        visible = "[Not(Or(Or(Or(Or(Or(Or(Or(Or(GetVariableSystem.Exists('sakuya_test_btn1_clicked'), GetVariableSystem.Exists('sakuya_test_btn2_clicked')), GetVariableSystem.Exists('sakuya_test_btn3_clicked')), GetVariableSystem.Exists('sakuya_test_btn4_clicked')), GetVariableSystem.Exists('sakuya_test_btn5_clicked')), GetVariableSystem.Exists('sakuya_test_btn6_clicked')), GetVariableSystem.Exists('sakuya_test_btn7_clicked')), GetVariableSystem.Exists('sakuya_test_btn8_clicked')), GetVariableSystem.Exists('sakuya_test_btn9_clicked')))]"
        position = { 300 150 }
        size = { 800 460 }
        icon = {
            size = { 100% 100% }
            texture = "gfx/interface/sakuya/about/defult.png"
        }
        textbox = {
            text = "SKY_DEFAULT_TITLE"
            fontsize = 42
            fontsize_min = 24
            autoresize = yes
            align = left|vcenter
            max_width = 500
            parentanchor = left|vcenter
            position = { 30 0 }
        }
    }

    # ============================================================
    # 背景高亮系统 - 导航栏底色随按钮变化
    # ============================================================
    widget = {
        position = { 100 150 }
        size = { 200 460 }

        # 默认底层
        icon = {
            name = "sakuya_test_bk_default"
            size = { 100% 100% }
            texture = "gfx/interface/sakuya/bkd.png"
            color = { 1 1 1 1 }
        }

        # 按钮1叠加 - 红色调
        widget = {
            size = { 100% 100% }
            visible = "[Or(GetVariableSystem.HasValue('sakuya_test_hover', 'btn1'), GetVariableSystem.Exists('sakuya_test_btn1_clicked'))]"
            alpha = 0
            state = { name = _show alpha = 1 duration = 0.15 using = Animation_Curve_Default }
            state = { name = _hide alpha = 0 duration = 0.25 using = Animation_Curve_Default }
            icon = { size = { 100% 100% } texture = "gfx/interface/backgrounds/big_header_pattern.dds" spriteType = Corneredtiled texture_density = 2 color = { 0.3608 0.2941 0.2588 1 } }
        }
        # 按钮2叠加 - 藏红花色
